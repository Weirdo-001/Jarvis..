# ============================================================
# JARVIS — Environment Variables & API Keys Template
# Copy this file to .env and fill in your keys.
# ============================================================

# --- 1. Groq (Get key at: https://console.groq.com/keys) ---
GROQ_API_KEY_1=

# --- 2. Google Gemini (Get key at: https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY_1=

# --- 3. Cerebras (Get key at: https://cloud.cerebras.ai/) ---
CEREBRAS_API_KEY_1=

# --- 4. OpenRouter (Get key at: https://openrouter.ai/) ---
OPENROUTER_API_KEY_1=

# Optional Settings
JARVIS_USER_NAME=Miss Aarushi
JARVIS_LISTEN_MODE=continuous
JARVIS_TTS_ENGINE=edge
JARVIS_STT_ENGINE=whisper
